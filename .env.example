# Optional. The setup screen saves these to ~/.config/ai-tutor/settings.json (mode 600), which wins over this file.
# Any OpenAI-compatible server: OpenAI, a local server, a LAN server.
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=
# Leave empty if the server needs no key.
LLM_API_KEY=
# Where books, submissions, frames and app.db live. Default: ./data
AI_TUTOR_DATA=
